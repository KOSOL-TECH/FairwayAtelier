{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fairway-atelier",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Worker cache in front of the Worker: public pages declare a cache lifetime
  // and tag (src/middleware.ts) and are purged by tag when an admin saves a
  // change. Each deploy starts with an empty cache (no cross-version reuse).
  "cache": { "enabled": true },
  // Serve only on the custom domains below, not on *.workers.dev.
  "workers_dev": false,
  "preview_urls": false,
  // Serve /journal (journal/index.html) without redirecting to /journal/,
  // matching the canonical URLs and the sitemap.
  "assets": { "binding": "ASSETS", "html_handling": "drop-trailing-slash" },
  // Enquiry rate limit: 5 requests per 60 seconds per client IP (Workers rate
  // limiting only supports 10s or 60s windows). namespace_id is any integer
  // unique within the Cloudflare account.
  "ratelimits": [
    {
      "name": "ENQUIRY_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 }
    },
    // Admin sign-in attempts: 5 per 60 seconds per client IP.
    {
      "name": "LOGIN_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 5, "period": 60 }
    }
  ],
  // Media library uploads (docs/admin.md), resized on request by the Images
  // binding (5,000 unique transformations/month free).
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "fairway-atelier-media" }],
  "images": { "binding": "IMAGES" },
  // Admin sign-in also needs the secret SESSION_SECRET (signs the session
  // cookie): npx wrangler secret put SESSION_SECRET
  // Enquiry emails (Cloudflare Email Service). The sender must be on a domain
  // onboarded to Email Sending; sending to guests needs the Workers Paid plan.
  "send_email": [
    { "name": "EMAIL", "allowed_sender_addresses": ["atelier@fairwayatelier.com"] }
  ],
  // Admin data (docs/admin.md). Schema changes are SQL files in migrations/:
  // npx wrangler d1 migrations apply DB --remote
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fairway-atelier",
      "database_id": "dc7c4b90-b24e-4196-b4df-9c98e288af32",
      "migrations_dir": "migrations"
    }
  ],
  // Custom domains. Cloudflare creates the DNS records and certificates;
  // the hostnames must not have other DNS records.
  "routes": [
    { "pattern": "fairwayatelier.com", "custom_domain": true },
    { "pattern": "www.fairwayatelier.com", "custom_domain": true }
  ]
}
