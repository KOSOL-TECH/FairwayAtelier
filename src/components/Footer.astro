---
import { env } from 'cloudflare:workers';
import crest from '../assets/crest.svg';
import { CONTACT_EMAIL, FOOTER_JOURNEY, FOOTER_LEGAL, FOOTER_PLAN } from '../lib/site';
import { loadPage } from '../lib/copy';
import footer from '../lib/pages/footer';

const c = await loadPage(env.DB, footer);
// Legal link labels are editable; their URLs stay in FOOTER_LEGAL.
const legal = ([1, 2, 3, 4] as const).map((n, i) => [c.t[`legal${n}Label` as const], FOOTER_LEGAL[i][1]]);
---
<footer class="site-footer">
  <div class="site-footer__grid">
    <div>
      <div class="site-footer__crest">
        <img src={crest.src} alt="" width="59" height="60" />
      </div>
      <div class="site-footer__tagline">{c.t.tagline}</div>
    </div>
    <nav aria-labelledby="ft-journey">
      <div id="ft-journey" class="site-footer__heading">{c.t.journeyHeading}</div>
      <div class="site-footer__links">
        {FOOTER_JOURNEY.map(([label, href]) => <a href={href}>{label}</a>)}
      </div>
    </nav>
    <nav aria-labelledby="ft-plan">
      <div id="ft-plan" class="site-footer__heading">{c.t.planHeading}</div>
      <div class="site-footer__links">
        {FOOTER_PLAN.map(([label, href]) => <a href={href}>{label}</a>)}
      </div>
    </nav>
    <div>
      <div class="site-footer__heading">{c.t.enquiriesHeading}</div>
      <div class="site-footer__col">
        <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a><br />{c.t.enquiriesLine1}<br />{c.t.enquiriesLine2}
      </div>
    </div>
  </div>
  <div class="site-footer__legal">
    <p class="site-footer__disclosure">
      {c.t.disclosure}
    </p>
    <div class="site-footer__bottom">
      <span>{c.t.legalLine}</span>
      <span class="site-footer__legal-links">
        {legal.map(([label, href]) => <a href={href}>{label}</a>)}
        <button type="button" class="site-footer__cookie-btn" data-open-consent>{c.t.cookieSettings}</button>
      </span>
    </div>
  </div>
</footer>

<script>
  import { OPEN_CONSENT_EVENT } from '../lib/consent';
  document.querySelector('[data-open-consent]')?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent(OPEN_CONSENT_EVENT));
  });
</script>

<style>
  .site-footer { background: var(--surface-inverse); padding: 64px 40px 36px; }
  .site-footer__grid {
    max-width: 1200px; margin: 0 auto; display: grid; gap: 48px;
    grid-template-columns: 2fr 1fr 1fr 1fr;
  }
  .site-footer__crest { display: inline-block; background: var(--color-cream); padding: 14px 18px; line-height: 0; }
  .site-footer__crest img { height: 60px; width: auto; }
  .site-footer__tagline {
    font-family: var(--font-display); font-style: italic; font-size: 19px; color: var(--text-on-dark); margin-top: 16px;
  }
  .site-footer__heading {
    font-family: var(--font-sans); font-size: 11px; letter-spacing: var(--tracking-caps); text-transform: uppercase;
    color: var(--color-brass-light); margin-bottom: 12px;
  }
  .site-footer__links { display: flex; flex-direction: column; }
  .site-footer__links a, .site-footer__col {
    font-family: var(--font-sans); font-size: 12px; line-height: 2.1; color: var(--text-on-dark);
  }
  .site-footer__links a { opacity: 0.75; transition: opacity var(--dur-fast) var(--ease-standard), color var(--dur-fast) var(--ease-standard); }
  .site-footer__links a:hover { color: var(--color-brass-light); opacity: 1; }
  .site-footer__col { opacity: 0.75; }
  .site-footer__col a { color: inherit; }
  .site-footer__col a:hover { color: var(--color-brass-light); }
  .site-footer__legal {
    max-width: 1200px; margin: 40px auto 0; padding-top: 24px; border-top: 1px solid rgba(245, 241, 232, 0.15);
  }
  .site-footer__disclosure {
    font-family: var(--font-sans); font-size: 11px; line-height: 1.7; color: var(--text-on-dark);
    opacity: 0.55; margin: 0 0 14px; max-width: 820px;
  }
  .site-footer__bottom {
    display: flex; justify-content: space-between; flex-wrap: wrap; gap: 12px;
    font-family: var(--font-sans); font-size: 11px; letter-spacing: 0.08em; color: var(--text-on-dark);
  }
  /* 0.55 rather than the prototype's 0.5 so 11px text clears WCAG AA (4.5:1) on charcoal */
  .site-footer__bottom > span:first-child { opacity: 0.55; }
  .site-footer__legal-links { display: flex; gap: 18px; flex-wrap: wrap; }
  .site-footer__legal-links a, .site-footer__cookie-btn { color: var(--text-on-dark); opacity: 0.55; }
  .site-footer__legal-links a:hover, .site-footer__cookie-btn:hover { color: var(--color-brass-light); opacity: 1; }
  .site-footer__cookie-btn {
    background: none; border: none; padding: 0; cursor: pointer;
    font: inherit; letter-spacing: inherit;
  }
  @media (max-width: 960px) {
    .site-footer__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 620px) {
    .site-footer { padding-left: 22px; padding-right: 22px; }
    .site-footer__grid { grid-template-columns: minmax(0, 1fr); gap: 28px; }
  }
</style>
