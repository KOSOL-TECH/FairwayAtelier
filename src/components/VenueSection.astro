---
import MediaImage from './MediaImage.astro';
import { Eyebrow } from './ui/Eyebrow';

interface Props {
  label: string;
  title: string;
  lead: string;
  items: Array<{ img: { id: string; width: number; height: number; alt: string } | null; name: string; meta: string; copy: string }>;
}
const { label, title, lead, items } = Astro.props;
---
<section class="sec" style="--max:1200px; --pt:24px; --pb:72px">
  <Eyebrow rules tone="brass">{label}</Eyebrow>
  <h2 class="display-md center">{title}</h2>
  <p class="center lead">{lead}</p>
  <div class="grid grid-3">
    {items.map((c) => (
      <div class="venue">
        {c.img && <MediaImage media={c.img} alt={c.name} class="media media--4x3" sizes="(max-width: 620px) 100vw, (max-width: 960px) 50vw, 380px" />}
        <div class="venue__body">
          <div class="label">{c.meta}</div>
          <h3>{c.name}</h3>
          <p>{c.copy}</p>
        </div>
      </div>
    ))}
  </div>
</section>

<style>
  h2 { margin: 14px 0 12px; }
  .lead { max-width: 620px; margin: 0 auto 40px; }
  .venue { border: 1px solid var(--border-hairline); background: var(--surface-card); }
  .venue__body { padding: 20px 22px 22px; }
  .venue h3 { font-size: 24px; margin: 8px 0; }
  .venue p { font-size: 14px; margin: 0; }
</style>
