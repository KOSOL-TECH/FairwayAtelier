---
/** Named-asset disclosure, required wherever restaurants, hotels or courses are named. Edited with the footer (/admin/pages). */
import { env } from 'cloudflare:workers';
import { loadPage } from '../lib/copy';
import footer from '../lib/pages/footer';

const c = await loadPage(env.DB, footer);
---
<p class="disclosure">
  {c.t.disclosure}
</p>
