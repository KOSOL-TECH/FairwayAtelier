---
import '../styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
const email = Astro.locals.adminEmail;
const path = Astro.url.pathname;

/** Sections land one phase at a time (docs/admin.md); `href: null` shows them as coming soon. */
const NAV: { label: string; href: string | null }[] = [
  { label: 'Overview', href: '/admin' },
  { label: 'Weeks', href: '/admin/weeks' },
  { label: 'Enquiries', href: null },
  { label: 'Journal', href: null },
  { label: 'Pages', href: null },
];
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} · Fairway Atelier Admin</title>
    <link rel="icon" type="image/png" href="/favicon.png" />
  </head>
  <body class="admin">
    <header class="admin-bar">
      <a class="admin-brand" href="/admin">Fairway Atelier <span>Admin</span></a>
      <nav aria-label="Admin">
        {NAV.map(({ label, href }) =>
          href ? (
            <a href={href} aria-current={(href === '/admin' ? path === href : path.startsWith(href)) ? 'page' : undefined}>{label}</a>
          ) : (
            <span class="soon" title="Coming soon">{label}</span>
          ),
        )}
      </nav>
      <div class="admin-user">
        <span>{email}</span>
        <form method="post" action="/admin/logout"><button type="submit">Sign out</button></form>
        <a href="/" target="_blank" rel="noopener">View site</a>
      </div>
    </header>
    <main id="main" class="admin-main">
      <h1>{title}</h1>
      <slot />
    </main>
  </body>
</html>

<style is:global>
  .admin { background: var(--surface-page); color: var(--text-body); min-height: 100vh; }
  .admin-bar {
    display: flex; flex-wrap: wrap; align-items: center; gap: 12px 32px;
    padding: 14px 24px; background: var(--surface-inverse); color: var(--text-on-dark);
    font-family: var(--font-sans); font-size: 14px;
  }
  .admin-bar a { color: inherit; text-decoration: none; }
  .admin-bar a:hover, .admin-bar a[aria-current='page'] { text-decoration: underline; text-underline-offset: 4px; }
  .admin-brand { font-family: var(--font-serif); font-size: 20px; }
  .admin-brand span { font-family: var(--font-sans); font-size: 12px; letter-spacing: 0.12em; text-transform: uppercase; opacity: 0.8; margin-left: 6px; }
  .admin-bar nav { display: flex; flex-wrap: wrap; gap: 20px; flex: 1; }
  .admin-bar .soon { opacity: 0.55; cursor: default; }
  .admin-user { display: flex; flex-wrap: wrap; gap: 16px; opacity: 0.9; }
  .admin-user form { margin: 0; }
  .admin-user button { font: inherit; color: inherit; background: none; border: 0; padding: 0; cursor: pointer; }
  .admin-user button:hover { text-decoration: underline; text-underline-offset: 4px; }
  .admin-main { max-width: 1100px; margin: 0 auto; padding: 32px 24px 64px; font-family: var(--font-sans); }
  .admin-main h1 { font-family: var(--font-serif); color: var(--text-heading); font-weight: 400; font-size: 36px; margin: 0 0 24px; }
  .admin-main h2 { font-family: var(--font-serif); color: var(--text-heading); font-weight: 400; font-size: 24px; margin: 40px 0 12px; }
  .admin-table { width: 100%; border-collapse: collapse; background: var(--surface-card); font-size: 14px; }
  .admin-table th, .admin-table td { text-align: left; padding: 10px 12px; border-bottom: 1px solid var(--border-hairline); vertical-align: top; }
  .admin-table th { color: var(--text-heading); font-weight: 600; }
  .admin-cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 16px; }
  .admin-card { background: var(--surface-card); border: 1px solid var(--border-hairline); padding: 20px; }
  .admin-card h3 { margin: 0 0 6px; font-size: 16px; color: var(--text-heading); }
  .admin-card p { margin: 0; font-size: 14px; color: var(--text-muted); }
  .admin-empty { color: var(--text-muted); font-size: 14px; }
  .admin-main a { color: var(--text-accent); }
  .admin-intro { font-size: 14px; max-width: 720px; }
  .admin-flash { background: #E7EEE5; color: #2F4A2B; padding: 10px 14px; font-size: 14px; }
  .admin-error { background: #F6E7E2; color: #7A2E1F; padding: 10px 14px; font-size: 14px; }
  .admin-button, .admin-main button[type='submit'] {
    display: inline-block; font: inherit; font-size: 13px; letter-spacing: 0.06em; text-transform: uppercase; text-decoration: none;
    padding: 9px 16px; border: 0; cursor: pointer; background: var(--surface-accent); color: var(--text-on-dark) !important;
  }
  .admin-button:hover, .admin-main button[type='submit']:hover { background: var(--color-fairway-deep); }
  .admin-inline { display: flex; gap: 8px; align-items: center; margin: 0; }
  .admin-inline button[type='submit'] { padding: 6px 10px; font-size: 12px; }
  .admin-main select, .admin-main input[type='text'], .admin-main input[type='date'] {
    font: inherit; font-size: 15px; padding: 8px 10px; border: 1px solid var(--color-soft-stone); background: var(--surface-card); color: var(--text-heading);
  }
  .admin-main [aria-invalid='true'] { border-color: #A0412D; }
  .admin-form { max-width: 640px; display: grid; gap: 20px; }
  .admin-form fieldset { border: 1px solid var(--border-hairline); background: var(--surface-card); padding: 16px 20px 4px; margin: 0; }
  .admin-form legend { font-family: var(--font-serif); font-size: 20px; color: var(--text-heading); padding: 0 6px; }
  .admin-row { display: grid; gap: 6px; margin-bottom: 16px; }
  .admin-row label { font-size: 14px; font-weight: 600; color: var(--text-heading); }
  .admin-row input[type='text'] { width: 100%; box-sizing: border-box; }
  .admin-row input[type='date'], .admin-row select { justify-self: start; }
  .admin-check { display: flex; gap: 8px; align-items: center; font-weight: 400 !important; }
  .admin-hint { margin: 0; font-size: 13px; color: var(--text-muted); }
  .admin-field-error { margin: 0; font-size: 13px; color: #A0412D; }
  .admin-actions { display: flex; gap: 20px; align-items: center; }
  .admin-danger { margin-top: 40px; padding-top: 20px; border-top: 1px solid var(--border-hairline); }
  .admin-main .admin-danger button[type='submit'] { background: none; color: #A0412D !important; border: 1px solid #A0412D; }
  .admin-past { margin-top: 32px; }
  .admin-past summary { cursor: pointer; font-size: 14px; margin-bottom: 12px; }
  @media (max-width: 620px) {
    .admin-table { display: block; overflow-x: auto; }
  }
</style>
