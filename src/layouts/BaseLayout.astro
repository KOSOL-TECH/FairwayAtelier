---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { CookieConsent } from '../components/islands/CookieConsent';
import { TRAVEL_AGENCY_LD, canonical } from '../lib/site';

interface Props {
  title: string;
  description: string;
  /** Social title/description, when they differ from the document's */
  ogTitle?: string;
  ogDescription?: string;
  ogType?: 'website' | 'article';
  /** Extra JSON-LD objects for this page (TravelAgency is always included) */
  jsonLd?: object[];
  /** Set false for pages that must not be indexed (404) */
  index?: boolean;
  /** Social image for this page (absolute URL and size); the brand cover by default */
  ogImage?: { url: string; width: number; height: number; alt: string };
  /** Set false where a signed-in guest should not be asked a profile question (the enquiry form, legal pages, their own profile) */
  prompt?: boolean;
}

const { title, description, ogTitle = title, ogDescription = description, ogType = 'website', jsonLd = [], index = true, prompt = true } = Astro.props;
const path = Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '/') || '/';
const url = canonical(path);
const og = Astro.props.ogImage ?? {
  url: new URL('/assets/og-cover.png', Astro.site).href,
  width: 1200,
  height: 630,
  alt: 'Fairway Atelier — bespoke luxury golf travel in Brittany',
};
const ogImage = og.url;
const ld = [TRAVEL_AGENCY_LD, ...jsonLd];
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Fairway Atelier SAS" />
    <meta name="theme-color" content="#2F3133" />
    <meta name="robots" content={index ? 'index, follow' : 'noindex, follow'} />
    {index && <link rel="canonical" href={url} />}
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Fairway Atelier" />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:url" content={url} />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content={String(og.width)} />
    <meta property="og:image:height" content={String(og.height)} />
    <meta property="og:image:alt" content={og.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <link rel="sitemap" href="/sitemap.xml" />
    {ld.map((obj) => <script type="application/ld+json" set:html={JSON.stringify(obj)} />)}
    {/* Pages are cached and the same for everyone. `signed-in` comes from a cookie that holds nothing but "1"
        (set beside the real session cookie) and only switches the header link to "Profile". */}
    <script is:inline>document.documentElement.classList.add('js');if(document.cookie.split('; ').indexOf('fa_in=1')>-1)document.documentElement.classList.add('signed-in');</script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <slot />
    <Footer />
    <CookieConsent client:idle />
    {prompt && <div id="profile-prompt"></div>}
    <script>
      import { initAnalytics } from '../lib/analytics';
      import { initScrollReveal } from '../lib/scroll-reveal';
      initAnalytics();
      initScrollReveal();
      // A later question for a signed-in guest (docs/accounts.md). Loaded only for them, so other visitors download nothing more.
      const slot = document.getElementById('profile-prompt');
      if (slot && document.documentElement.classList.contains('signed-in')) {
        import('../components/islands/ProfilePrompt').then((m) => m.mountProfilePrompt(slot));
      }
    </script>
  </body>
</html>
