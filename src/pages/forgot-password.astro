---
import { env } from 'cloudflare:workers';
import AuthLayout from '../layouts/AuthLayout.astro';
import { requestPasswordReset } from '../lib/account/auth';
import { resetEmail, resetUrl, sendAccountEmail } from '../lib/account/email';
import { siteOrigin } from '../lib/account/guard';
import { background, clientIp, isLocal, limited } from '../lib/account/http';
import { normaliseEmail } from '../lib/account/profile';

export const prerender = false;

let sent = false;
let error = '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const email = normaliseEmail(String(form.get('email') ?? ''));
  if (!email) {
    error = 'Please check this email address.';
    Astro.response.status = 422;
  } else if (await limited(env.SIGNUP_LIMITER, `reset:${clientIp(Astro.request)}`, `reset-email:${email}`)) {
    error = 'Too many attempts. Please wait a minute and try again.';
    Astro.response.status = 429;
  } else {
    // The page says the same thing whether or not the address has a profile.
    const request = await requestPasswordReset(env.DB, email);
    if (request) {
      const message = resetEmail(resetUrl(siteOrigin(Astro.url), request.token));
      await background(Astro.locals, sendAccountEmail(env.EMAIL, request.account.email, message, { local: isLocal(Astro.url) }));
    }
    sent = true;
  }
}
---
<AuthLayout title="Reset your password">
  <div class="frame auth__card">
    <div class="frame__inner auth__inner">
      <p class="label label--11 auth__eyebrow">Your profile</p>
      {sent ? (
        <Fragment>
          <h1 class="display-md auth__title">Check your inbox</h1>
          <p class="auth__lead" role="status">
            If that address has a profile with us, a link to choose a new password is on its way. It works once, for one hour.
          </p>
          <p class="auth__links"><a href="/sign-in">Back to sign in</a></p>
        </Fragment>
      ) : (
        <Fragment>
          <h1 class="display-md auth__title">Reset your password</h1>
          <p class="auth__lead">Enter the email you signed up with and we will send you a link to choose a new password.</p>
          {error && <p class="auth__error" role="alert">{error}</p>}
          <form method="post" class="auth__form">
            <div class="fa-field">
              <label class="fa-field__label" for="email">Email</label>
              <input id="email" class="fa-field__control" type="email" name="email" autocomplete="username" required />
            </div>
            <button type="submit" class="fa-btn fa-btn--primary fa-btn--lg auth__submit">Send the link</button>
          </form>
          <p class="auth__links">Signed up with Google or Apple? Use that button on the <a href="/sign-in">sign-in page</a>.</p>
        </Fragment>
      )}
    </div>
  </div>
</AuthLayout>
