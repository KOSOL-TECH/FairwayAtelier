---
import { env } from 'cloudflare:workers';
import LegalLayout from '../layouts/LegalLayout.astro';
import { loadPage } from '../lib/copy';
import page from '../lib/pages/privacy';

// Rendered on each request so edits in /admin/pages show at once.
export const prerender = false;

const c = await loadPage(env.DB, page);
const sections = ([1, 2, 3, 4, 5, 6] as const).map((n) => [c.t[`section${n}Title` as const], c.md(`section${n}Body` as const)]);
---
<LegalLayout title={c.t.metaTitle} description={c.t.metaDescription} heading={c.t.heading} updated={c.t.updated}
  placeholder={c.t.placeholder}>
  <Fragment set:html={c.md('intro')} />
  {sections.map(([heading, body]) => (
    <>
      <h2>{heading}</h2>
      <Fragment set:html={body} />
    </>
  ))}
</LegalLayout>
