---
import { env } from 'cloudflare:workers';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { JoinFlow } from '../components/islands/JoinFlow';
import { enabledProviders } from '../lib/account/oauth';
import { loadPage } from '../lib/copy';
import page from '../lib/pages/private';

// Rendered on each request so edits in /admin/pages show at once.
export const prerender = false;

const c = await loadPage(env.DB, page);
const options = ([1, 2, 3, 4] as const).map((n) => [c.t[`option${n}Title` as const], c.t[`option${n}Copy` as const]]);
---
<BaseLayout title={c.t.metaTitle} description={c.t.metaDescription}>
  <main id="main">
    <PageHero eyebrow={c.t.heroEyebrow} title={c.t.heroTitle} intro={c.t.heroIntro} />
    <section class="sec" style="--max:1080px; --pt:24px; --pb:72px">
      <div class="grid split">
        {options.map(([t, copy]) => (
          <div class="option">
            <div class="option__head"><span class="diamond" aria-hidden="true"></span><h2>{t}</h2></div>
            <p>{copy}</p>
          </div>
        ))}
      </div>
    </section>
    <section class="band band--inverse center" style="--max:640px">
      <div class="inner">
        <div class="label label--11 label--light">{c.t.ctaLabel}</div>
        <h2 class="display-md on-dark cta__title">{c.t.ctaTitle}</h2>
        <p class="on-dark-soft cta__copy">{c.t.ctaCopy}</p>
        {/* Here, creating a profile is how a private journey is requested: the same few questions as /join, then the
            account, set into the page. The team is told at once (src/lib/account/private.ts). Without JavaScript,
            the enquiry form is offered instead. */}
        <JoinFlow client:visible variant="private" providers={enabledProviders(env)} />
        <noscript><p class="cta__alt"><a href="/enquire">{c.t.ctaButton}</a></p></noscript>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .option { border: 1px solid var(--border-hairline); background: var(--surface-card); padding: 28px 30px; }
  .option__head { display: flex; align-items: center; gap: 10px; margin-bottom: 10px; }
  .option h2 { font-size: 23px; }
  .option p { font-size: 14px; margin: 0; }
  .cta__title { margin: 16px 0 18px; }
  .cta__copy { margin: 0 0 32px; }
  .cta__alt { margin: 20px 0 0; }
  .cta__alt a { color: var(--color-brass-light); text-decoration: underline; text-underline-offset: 3px; }
  @media (max-width: 620px) { .option { padding: 24px 22px; } }
</style>
