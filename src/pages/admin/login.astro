---
import { safeNext } from '../../lib/account/guard';

/**
 * The admin no longer has its own login: everyone signs in at /sign-in, and
 * the admin role on an account opens /admin (docs/accounts.md). This address
 * is kept for old bookmarks. The middleware has already asked for an admin
 * sign-in before this runs, so it only has to pass the visitor on.
 */
export const prerender = false;

const next = safeNext(Astro.url.searchParams.get('next'), '/admin');
return Astro.redirect(next.startsWith('/admin/login') ? '/admin' : next, 303);
---
