---
import { env } from 'cloudflare:workers';
import AdminLayout from '../../layouts/AdminLayout.astro';
import { recentChanges } from '../../lib/admin/audit';

export const prerender = false;

const changes = await recentChanges(env.DB, 20);
const when = (iso: string) =>
  new Date(iso).toLocaleString('en-GB', { dateStyle: 'medium', timeStyle: 'short', timeZone: 'Europe/Paris' });

const SECTIONS: { title: string; text: string; href?: string; phase?: string }[] = [
  { title: 'Weeks', text: 'Open, limited, sold and waitlist weeks for /availability, Home and the enquiry form.', href: '/admin/weeks' },
  { title: 'Enquiries', text: 'Every enquiry from the website, with status and notes. The start of the CRM.', href: '/admin/enquiries' },
  { title: 'Customers', text: 'Guest profiles and customer sheets: preferences, enquiries, team notes, and who has the admin role.', href: '/admin/customers' },
  { title: 'Journal', text: 'Articles and their images.', href: '/admin/journal' },
  { title: 'Media', text: 'The image library for the journal and the pages.', href: '/admin/media' },
  { title: 'Pages', text: 'Copy and images on every page.', href: '/admin/pages' },
];
---
<AdminLayout title="Overview">
  <div class="admin-cards">
    {SECTIONS.map((s) => (
      <div class="admin-card">
        <h3>{s.href ? <a href={s.href}>{s.title}</a> : s.title}</h3>
        <p>{s.text}</p>
        {s.phase && <p><em>{s.phase}</em></p>}
      </div>
    ))}
  </div>

  <h2>Recent changes</h2>
  {changes.length === 0 ? (
    <p class="admin-empty">No changes yet.</p>
  ) : (
    <table class="admin-table">
      <thead><tr><th>When (Paris)</th><th>Who</th><th>Change</th></tr></thead>
      <tbody>
        {changes.map((c) => (
          <tr><td>{when(c.at)}</td><td>{c.email}</td><td>{c.action} {c.entity} {c.entity_id}</td></tr>
        ))}
      </tbody>
    </table>
  )}
</AdminLayout>
