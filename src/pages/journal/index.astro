---
import { env } from 'cloudflare:workers';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import MediaImage from '../../components/MediaImage.astro';
import { loadPage } from '../../lib/copy';
import page from '../../lib/pages/journal';
import { publishedArticles, splitFeatured } from '../../lib/articles';

// Rendered on each request from the articles published in /admin/journal and the copy edited in /admin/pages.
export const prerender = false;

const c = await loadPage(env.DB, page);
const { featured, rest: posts } = splitFeatured(await publishedArticles(env.DB));
---
<BaseLayout title={c.t.metaTitle} description={c.t.metaDescription}>
  <main id="main" class="sec" style="--max:1200px; --pt:0px; --pb:96px">
    <PageHero eyebrow={c.t.heroEyebrow} title={c.t.heroTitle} intro={c.t.heroIntro} />
    {featured && (
      <a href={`/journal/${featured.slug}`} class="featured grid split-wide">
        {featured.hero && <MediaImage media={featured.hero} alt="" class="featured__img" sizes="(max-width: 960px) 100vw, 600px" />}
        <div class="featured__body">
          <div class="label">{c.t.featuredLabel} · {featured.kicker}</div>
          <h2 class="display-sm">{featured.title}</h2>
          <p>{featured.excerpt}</p>
          <span class="read-more featured__more">{c.t.readMore}</span>
        </div>
      </a>
    )}
    <div class="grid grid-2">
      {posts.map((p) => (
        <a href={`/journal/${p.slug}`} class="post">
          {p.hero && <MediaImage media={p.hero} alt="" class="post__img" sizes="(max-width: 620px) 100vw, 150px" />}
          <div class="post__body">
            <div class="label">{p.kicker}</div>
            <h3>{p.title}</h3>
            <div class="post__read">{p.read_time} {c.t.readSuffix}</div>
          </div>
        </a>
      ))}
    </div>
  </main>
</BaseLayout>

<style>
  .featured {
    --gap: 40px; align-items: center; margin-bottom: 40px;
    background: var(--surface-card); border: 1px solid var(--border-hairline);
  }
  .featured__img { display: block; width: 100%; height: 100%; min-height: 300px; object-fit: cover; }
  .featured__body { padding: 36px 44px 36px 12px; }
  .featured h2 { margin: 12px 0; }
  .featured p { font-size: 15px; margin: 0 0 18px; }
  .featured__more { font-size: 12px; }
  .featured, .post { color: inherit; text-decoration: none; }
  .featured:hover .read-more, .post:hover h3 { color: var(--accent-text); }
  .post {
    display: grid; grid-template-columns: 150px 1fr; align-items: stretch;
    border: 1px solid var(--border-hairline); background: var(--surface-card);
  }
  .post__img { display: block; width: 100%; height: 100%; min-height: 150px; object-fit: cover; }
  .post__body { padding: 22px 24px; display: flex; flex-direction: column; justify-content: center; }
  .post h3 { font-size: 21px; margin: 8px 0 10px; line-height: 1.2; }
  .post__read { font-family: var(--font-sans); font-size: 12px; color: var(--text-muted); }
  @media (max-width: 960px) {
    .featured { --gap: 0px; }
    .featured__img { min-height: 240px; height: 240px; }
    .featured__body { padding: 28px 24px; }
  }
  @media (max-width: 620px) {
    .post { grid-template-columns: minmax(0, 1fr); }
    .post__img { min-height: 200px; height: 200px; }
  }
</style>
