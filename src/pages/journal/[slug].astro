---
import { env } from 'cloudflare:workers';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Eyebrow } from '../../components/ui/Eyebrow';
import { Divider } from '../../components/ui/Divider';
import { Button } from '../../components/ui/Button';
import MediaImage from '../../components/MediaImage.astro';
import { SITE_URL, canonical } from '../../lib/site';
import { getArticle, renderMarkdown } from '../../lib/articles';
import { mediaUrl } from '../../lib/media';
import { notFound } from '../../lib/not-found';

// Rendered on each request from the articles edited in /admin/journal.
export const prerender = false;

const a = await getArticle(env.DB, Astro.params.slug ?? '');
if (!a) return notFound(Astro.url);
const html = renderMarkdown(a.body);
const title = `${a.title} — Fairway Atelier`;

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: a.title,
  description: a.lede,
  ...(a.hero && { image: new URL(mediaUrl(a.hero.id, 1280), SITE_URL).href }),
  mainEntityOfPage: canonical(`/journal/${a.slug}`),
  dateModified: a.updated_at,
  author: { '@type': 'Organization', name: 'Fairway Atelier' },
  publisher: { '@type': 'Organization', name: 'Fairway Atelier', logo: { '@type': 'ImageObject', url: `${SITE_URL}/favicon.png` } },
};
---
<BaseLayout title={title} description={a.lede} ogType="article" jsonLd={[articleLd]}>
  <main id="main">
    <section class="sec center" style="--max:820px; --pt:64px; --pb:8px">
      <a href="/" class="label label--11 label--muted back">← Home</a>
      <div style="margin-top:28px"><Eyebrow rules tone="brass">{a.eyebrow}</Eyebrow></div>
      <div class="label label--12 kicker">{a.kicker}</div>
      <h1 class="display-lg">{a.title}</h1>
    </section>
    <section class="sec" style="--max:1000px; --pt:0px; --pb:0px">
      {a.hero && <MediaImage media={a.hero} class="hero" sizes="(max-width: 1000px) 100vw, 920px" loading="eager" />}
    </section>
    <section class="sec" style="--max:720px; --pt:48px; --pb:0px">
      <p class="lede">{a.lede}</p>
    </section>
    <article class="sec prose" style="--max:720px; --pt:40px; --pb:8px">
      <Fragment set:html={html} />
    </article>
    <section class="sec" style="--max:720px; --pt:24px; --pb:24px">
      <Divider ornament tone="brass" style={{ maxWidth: 220, margin: '0 auto' }} />
    </section>
    {a.next_slug && a.next_label && (
      <section class="sec center" style="--pt:8px; --pb:40px">
        <div class="label label--11 label--muted continue">Continue reading</div>
        <a href={`/journal/${a.next_slug}`} class="next">{a.next_label} →</a>
      </section>
    )}
    <section class="band band--inverse center" style="--max:620px; --pt:72px; --pb:72px">
      <div class="inner">
        <h2 class="display-md on-dark cta__title">Begin your week in Brittany</h2>
        <Button href="/enquire">Enquire about a journey</Button>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .back:hover { color: var(--accent-text); }
  .kicker { margin-top: 20px; }
  h1 { margin: 12px 0 22px; }
  .hero { display: block; width: 100%; aspect-ratio: 16 / 7; object-fit: cover; border: 1px solid var(--border-hairline); }
  .lede { font-family: var(--font-display); font-size: 24px; font-style: italic; line-height: 1.5; color: var(--text-heading); margin: 0; }
  .prose :global(h2) { font-family: var(--font-display); font-size: var(--text-display-sm); color: var(--text-heading); margin: 28px 0 12px; }
  .prose :global(p) { font-family: var(--font-sans); font-size: 16px; line-height: var(--leading-body); color: var(--text-body); margin: 0 0 18px; }
  .prose :global(blockquote) {
    margin: 20px 0 36px; padding: 4px 0 4px 28px; border-left: 2px solid var(--accent);
    font-family: var(--font-display); font-size: 26px; font-style: italic; line-height: 1.4; color: var(--text-heading);
  }
  .prose :global(blockquote p) { font: inherit; color: inherit; margin: 0; }
  .continue { margin-bottom: 10px; }
  .next { font-family: var(--font-display); font-size: 30px; color: var(--text-heading); border-bottom: 1px solid var(--accent); padding-bottom: 4px; }
  .next:hover { color: var(--accent-text); }
  .cta__title { margin: 0 0 24px; }
</style>
