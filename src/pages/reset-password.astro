---
import { env } from 'cloudflare:workers';
import AuthLayout from '../layouts/AuthLayout.astro';
import { MIN_PASSWORD, resetPassword } from '../lib/account/auth';
import { startSession } from '../lib/account/http';
import { peekToken } from '../lib/account/store';

export const prerender = false;

// Opening the link changes nothing (mail scanners open links too): the password is set by the form below.
let token = (Astro.url.searchParams.get('token') ?? '').slice(0, 200);
let error = '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  token = String(form.get('token') ?? '').slice(0, 200);
  if (!env.SESSION_SECRET) {
    error = 'Sign-in is not available right now. Please try again later.';
    Astro.response.status = 503;
  } else {
    const result = await resetPassword(env.DB, token, String(form.get('password') ?? ''));
    if (result.ok) {
      await startSession(Astro.cookies, result.account, env.SESSION_SECRET);
      return Astro.redirect('/account?notice=password', 303);
    }
    if (result.error === 'password') {
      error = result.message;
      Astro.response.status = 422;
    }
  }
}

const usable = token !== '' && (await peekToken(env.DB, token, 'reset_password')) !== null;
if (!usable && Astro.response.status === 200) Astro.response.status = 410;
---
<AuthLayout title="Choose a new password">
  <div class="frame auth__card">
    <div class="frame__inner auth__inner">
      <p class="label label--11 auth__eyebrow">Your profile</p>
      {usable ? (
        <Fragment>
          <h1 class="display-md auth__title">Choose a new password</h1>
          {error && <p id="password-error" class="auth__error" role="alert">{error}</p>}
          <form method="post" class="auth__form">
            <input type="hidden" name="token" value={token} />
            <div class="fa-field">
              <label class="fa-field__label" for="password">New password</label>
              <input id="password" class="fa-field__control" type="password" name="password" autocomplete="new-password"
                minlength={MIN_PASSWORD} required aria-invalid={error ? 'true' : undefined}
                aria-describedby={error ? 'password-hint password-error' : 'password-hint'} />
              <span id="password-hint" class="fa-field__hint">{`At least ${MIN_PASSWORD} characters.`}</span>
            </div>
            <button type="submit" class="fa-btn fa-btn--primary fa-btn--lg auth__submit">Save and sign in</button>
          </form>
        </Fragment>
      ) : (
        <Fragment>
          <h1 class="display-md auth__title">This link has expired</h1>
          <p class="auth__lead" role="alert">Reset links work once, for one hour. Please ask for a new one.</p>
          <p class="auth__links"><a class="fa-btn fa-btn--primary fa-btn--md" href="/forgot-password">Send a new link</a></p>
        </Fragment>
      )}
    </div>
  </div>
</AuthLayout>
