---
import { env } from 'cloudflare:workers';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { Button } from '../components/ui/Button';
import { loadPage } from '../lib/copy';
import page from '../lib/pages/faq';

// Rendered on each request so edits in /admin/pages show at once.
export const prerender = false;

const c = await loadPage(env.DB, page);
const faqs = ([1, 2, 3, 4, 5, 6, 7, 8] as const).map((n) => [c.t[`q${n}` as const], c.t[`a${n}` as const]]);
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })),
};
---
<BaseLayout title={c.t.metaTitle} description={c.t.metaDescription} jsonLd={[faqLd]}>
  <main id="main">
    <PageHero eyebrow={c.t.heroEyebrow} title={c.t.heroTitle} intro={c.t.heroIntro} />
    <section class="sec" style="--max:820px; --pt:24px; --pb:40px">
      {faqs.map(([q, a], i) => (
        <details class="faq" open={i === 0}>
          <summary class="faq__q">
            <span>{q}</span>
            <span class="chevron" aria-hidden="true"></span>
          </summary>
          <p class="faq__a">{a}</p>
        </details>
      ))}
    </section>
    <section class="sec center" style="--pt:32px; --pb:80px">
      <Button variant="secondary" href="/enquire">{c.t.ctaButton}</Button>
    </section>
  </main>
</BaseLayout>

<style>
  .faq { border-top: 1px solid var(--border-hairline); }
  .faq__q {
    display: flex; justify-content: space-between; align-items: center; gap: 24px; padding: 22px 0;
    cursor: pointer; list-style: none; font-family: var(--font-display); font-size: 22px; color: var(--text-heading);
  }
  .faq__q::-webkit-details-marker { display: none; }
  .faq[open] .chevron { transform: rotate(-135deg); }
  .faq__a { font-family: var(--font-sans); font-size: 15px; line-height: var(--leading-body); color: var(--text-body); margin: 0 0 24px; max-width: 680px; }
</style>
