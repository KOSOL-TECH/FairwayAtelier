---
import { env } from 'cloudflare:workers';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import VenueSection from '../components/VenueSection.astro';
import Disclosure from '../components/Disclosure.astro';
import { Button } from '../components/ui/Button';
import { loadPage } from '../lib/copy';
import page from '../lib/pages/dining-and-golf';

// Rendered on each request so edits in /admin/pages show at once.
export const prerender = false;

const c = await loadPage(env.DB, page);
const courses = ([1, 2, 3] as const).map((n) => ({
  img: c.img(`course${n}Image`), name: c.t[`course${n}Name` as const], meta: c.t[`course${n}Meta` as const], copy: c.t[`course${n}Copy` as const],
}));
const tables = ([1, 2, 3] as const).map((n) => ({
  img: c.img(`table${n}Image`), name: c.t[`table${n}Name` as const], meta: c.t[`table${n}Meta` as const], copy: c.t[`table${n}Copy` as const],
}));
---
<BaseLayout title={c.t.metaTitle} description={c.t.metaDescription}>
  <main id="main">
    <PageHero eyebrow={c.t.heroEyebrow} title={c.t.heroTitle}
      intro={c.t.heroIntro} />
    <VenueSection label={c.t.coursesLabel} title={c.t.coursesTitle} items={courses}
      lead={c.t.coursesLead} />
    <div class="band--tint tables">
      <VenueSection label={c.t.tablesLabel} title={c.t.tablesTitle} items={tables}
        lead={c.t.tablesLead} />
    </div>
    <section class="sec center" style="--pt:72px; --pb:40px">
      <Disclosure />
      <div style="margin-top:28px"><Button href="/enquire">{c.t.ctaButton}</Button></div>
    </section>
  </main>
</BaseLayout>

<style>
  .tables { padding-top: 48px; }
</style>
