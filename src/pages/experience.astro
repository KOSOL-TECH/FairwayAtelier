---
import { env } from 'cloudflare:workers';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { Button } from '../components/ui/Button';
import { Eyebrow } from '../components/ui/Eyebrow';
import { Divider } from '../components/ui/Divider';
import { loadPage } from '../lib/copy';
import page from '../lib/pages/experience';

// Rendered on each request so edits in /admin/pages show at once.
export const prerender = false;

const c = await loadPage(env.DB, page);
const handled = ([1, 2, 3, 4, 5, 6] as const).map((n) => [c.t[`handled${n}Title` as const], c.t[`handled${n}Copy` as const]]);
const paths = ([1, 2, 3, 4] as const).map((n) => [c.t[`path${n}Title` as const], c.t[`path${n}Copy` as const]]);
---
<BaseLayout title={c.t.metaTitle} description={c.t.metaDescription}>
  <main id="main">
    <PageHero eyebrow={c.t.heroEyebrow} title={c.t.heroTitle}
      intro={c.t.heroIntro} />

    <section class="band band--inverse center" style="--max:760px; --pt:72px; --pb:72px">
      <div class="inner">
        <div class="label label--11 label--light">{c.t.promiseLabel}</div>
        <h2 class="display-md on-dark promise__title">{c.t.promiseTitle}</h2>
        <p class="on-dark-soft">
          {c.t.promiseCopy}
        </p>
      </div>
    </section>

    <section class="sec" style="--max:1080px">
      <Eyebrow rules tone="brass">{c.t.handledEyebrow}</Eyebrow>
      <h2 class="display-md center sec-title">{c.t.handledTitle}</h2>
      <div class="grid grid-3" style="--gap:40px">
        {handled.map(([t, copy]) => (
          <div>
            <div class="item-head"><span class="diamond" aria-hidden="true"></span><h3>{t}</h3></div>
            <p class="item-copy">{copy}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="band band--tint" style="--max:900px">
      <div class="inner grid split" style="--gap:48px">
        <div>
          <h2 class="display-sm pair__title">{c.t.team1Title}</h2>
          <p class="pair__copy">{c.t.team1Copy}</p>
        </div>
        <div>
          <h2 class="display-sm pair__title">{c.t.team2Title}</h2>
          <p class="pair__copy">{c.t.team2Copy}</p>
        </div>
      </div>
    </section>

    <section class="sec" style="--max:1080px">
      <Eyebrow rules tone="brass">{c.t.pathsEyebrow}</Eyebrow>
      <h2 class="display-md center sec-title">{c.t.pathsTitle}</h2>
      <div class="grid grid-4" style="--gap:20px">
        {paths.map(([t, copy]) => (
          <div class="path">
            <h3>{t}</h3>
            <p>{copy}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="sec center" style="--max:720px; --pt:20px; --pb:88px">
      <Divider ornament tone="brass" style={{ maxWidth: 220, margin: '0 auto 32px' }} />
      <p class="founder">
        &ldquo;{c.t.founderQuote}&rdquo;
      </p>
      <p class="label label--11 label--muted founder__by">{c.t.founderBy}</p>
      <div style="margin-top:32px"><Button href="/journey">{c.t.founderButton}</Button></div>
    </section>
  </main>
</BaseLayout>

<style>
  .promise__title { margin: 16px 0 18px; }
  .sec-title { margin: 14px 0 44px; }
  .item-head { display: flex; align-items: center; gap: 10px; margin-bottom: 10px; }
  .item-head h3 { font-size: 22px; }
  .item-copy { font-size: 14px; margin: 0; }
  .pair__title { margin: 0 0 14px; }
  .pair__copy { font-size: 15px; margin: 0; }
  .path { border: 1px solid var(--border-hairline); background: var(--surface-card); padding: 26px 24px; }
  .path h3 { font-size: 21px; margin: 0 0 10px; }
  .path p { font-size: 13px; margin: 0; }
  .founder { font-family: var(--font-display); font-style: italic; font-size: 24px; line-height: 1.5; color: var(--text-heading); }
  .founder__by { margin-top: 18px; }
</style>
