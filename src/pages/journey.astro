---
import { env } from 'cloudflare:workers';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { Eyebrow } from '../components/ui/Eyebrow';
import { JourneyTiers, type Tier } from '../components/islands/JourneyTiers';
import { loadPage } from '../lib/copy';
import { mediaUrl, snapWidth, srcset } from '../lib/media';
import page from '../lib/pages/journey';

// Rendered on each request so edits in /admin/pages show at once.
export const prerender = false;

const c = await loadPage(env.DB, page);
const days = ([1, 2, 3, 4, 5, 6, 7, 8] as const).map((n) => [c.t[`day${n}Label` as const], c.t[`day${n}Title` as const], c.t[`day${n}Copy` as const]]);

const toImg = (m: { id: string; width: number; height: number } | null) =>
  m && { src: mediaUrl(m.id, Math.min(snapWidth(1000), m.width)), srcset: srcset(m), width: m.width, height: m.height };
const tiers: Tier[] = ([1, 2] as const).map((n) => ({
  tab: c.t[`tier${n}Tab` as const],
  eyebrow: c.t[`tier${n}Eyebrow` as const],
  hotel: c.t[`tier${n}Hotel` as const],
  img: toImg(c.img(`tier${n}Image`)),
  lead: c.t[`tier${n}Lead` as const],
  points: ([1, 2, 3, 4] as const).map((i) => c.t[`tier${n}Point${i}` as const]),
}));
---
<BaseLayout title={c.t.metaTitle} description={c.t.metaDescription}>
  <main id="main">
    <PageHero eyebrow={c.t.heroEyebrow} title={c.t.heroTitle} introSize={16} pb={36}
      intro={c.t.heroIntro} />

    <section class="band band--inverse center" style="--max:860px; --pt:72px; --pb:72px">
      <div class="inner">
        <div class="label label--11 label--light">{c.t.diffLabel}</div>
        <h2 class="display-md on-dark diff__title">{c.t.diffTitle}</h2>
        <p class="on-dark-soft diff__copy">
          {c.t.diffCopy}
        </p>
        <div class="diff__points">
          {[c.t.diffPoint1, c.t.diffPoint2, c.t.diffPoint3].map((x) => (
            <div class="diff__point"><span class="diamond diamond--light" aria-hidden="true"></span>{x}</div>
          ))}
        </div>
      </div>
    </section>

    <section class="sec" style="--max:860px; --pt:72px; --pb:72px">
      <Eyebrow rules tone="brass">{c.t.daysEyebrow}</Eyebrow>
      <h2 class="display-md center days__title">{c.t.daysTitle}</h2>
      <p class="center days__intro">{c.t.daysIntro}</p>
      <ol class="days" role="list">
        {days.map(([d, t, copy]) => (
          <li class="day">
            <div class="label label--11 day__label">{d}</div>
            <div>
              <h3>{t}</h3>
              <p>{copy}</p>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <section class="band tiers" style="--max:1000px; --pt:76px; --pb:76px">
      <div class="inner">
        <Eyebrow rules tone="brass">{c.t.tiersEyebrow}</Eyebrow>
        <h2 class="display-md center tiers__title">{c.t.tiersTitle}</h2>
        <JourneyTiers client:idle tiers={tiers} />
        <p class="disclosure tiers__disclosure">
          {c.t.tiersDisclosure}
        </p>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .diff__title { margin: 16px 0 18px; }
  .diff__copy { max-width: 660px; margin: 0 auto; }
  .diff__points { display: flex; gap: 40px; justify-content: center; flex-wrap: wrap; margin-top: 36px; }
  .diff__point { display: flex; align-items: center; gap: 10px; font-family: var(--font-display); font-size: 20px; color: var(--text-on-dark); }

  .days__title { margin: 14px 0 12px; }
  .days__intro { max-width: 600px; margin: 0 auto 24px; }
  .days { list-style: none; margin: 0; padding: 0; }
  .day { display: grid; grid-template-columns: 120px 1fr; gap: 28px; padding: 26px 0; border-top: 1px solid var(--border-hairline); }
  .day__label { padding-top: 4px; }
  .day h3 { font-size: 24px; margin: 0 0 6px; }
  .day p { font-size: 15px; margin: 0; }

  .tiers { background: var(--surface-tint); border-top: 1px solid var(--border-hairline); }
  .tiers__title { margin: 14px 0 32px; }
  .tiers__disclosure { margin-top: 20px; max-width: 700px; }

  @media (max-width: 620px) {
    .day { grid-template-columns: 84px 1fr; gap: 16px; }
  }
</style>
