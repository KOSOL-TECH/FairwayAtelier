---
import { env } from 'cloudflare:workers';
import BaseLayout from '../layouts/BaseLayout.astro';
import { Button } from '../components/ui/Button';
import { Eyebrow } from '../components/ui/Eyebrow';
import Departures from '../components/Departures.astro';
import { Divider } from '../components/ui/Divider';
import { Testimonials } from '../components/islands/Testimonials';
import MediaImage from '../components/MediaImage.astro';
import { loadPage } from '../lib/copy';
import page from '../lib/pages/home';
// Vector brand art (crisp at any size). The villa sketch is inlined once as <symbol id="fav-villa">
// and drawn by both hero flanks; its styles are the .fav-* rules in components.css.
import crest from '../assets/crest.svg';
import villaSketch from '../assets/villa-banner.svg?raw';

// Rendered on demand and kept in the edge cache until an admin change purges it (src/middleware.ts).
export const prerender = false;

const c = await loadPage(env.DB, page);

const voices = ([1, 2, 3] as const).map((n) => ({
  quote: c.t[`voice${n}Quote` as const],
  name: c.t[`voice${n}Name` as const],
  detail: c.t[`voice${n}Detail` as const],
}));
const atmospheres = ([[1, 'coast'], [2, 'dining'], [3, 'restore']] as const).map(([n, slug]) => ({
  slug,
  img: c.img(`card${n}Image` as const),
  title: c.t[`card${n}Title` as const],
  copy: c.t[`card${n}Copy` as const],
}));
const tiers = ([1, 2] as const).map((n) => ({
  eyebrow: c.t[`tier${n}Eyebrow` as const],
  name: c.t[`tier${n}Name` as const],
  copy: c.t[`tier${n}Copy` as const],
  cta: c.t[`tier${n}Button` as const],
}));
const trust = ([1, 2, 3, 4] as const).map((n) => [c.t[`trust${n}Title` as const], c.t[`trust${n}Copy` as const]]);
---
<BaseLayout title={c.t.metaTitle} description={c.t.metaDescription}
  ogDescription={c.t.ogDescription}>
  <Fragment set:html={villaSketch} />
  <main id="main">
    <section class="hero">
      <div class="fav-flank fav-flank--right" aria-hidden="true"><svg viewBox="0 0 720 560" focusable="false"><use href="#fav-villa"/></svg></div>
      <div class="fa-sig fa-sig--left" aria-hidden="true"><span class="fa-sig__pair">FA</span><span class="fa-sig__rule"></span><span class="fa-sig__word">Fairway Atelier</span></div>
      <div class="fa-sig fa-sig--right" aria-hidden="true"><span class="fa-sig__pair">FA</span><span class="fa-sig__rule"></span><span class="fa-sig__word">Fairway Atelier</span></div>
      <div class="hero__content">
        <img src={crest.src} alt="" width="103" height="104" class="hero__crest" />
        <h1 class="display-xl">{c.t.heroTitle}</h1>
        <p class="hero__lead">{c.t.heroLead}</p>
        <div class="hero__ctas">
          <Button href="/availability">{c.t.heroButton1}</Button>
          <Button variant="secondary" href="/enquire">{c.t.heroButton2}</Button>
        </div>
      </div>
      <div class="fav-flank fav-flank--left" aria-hidden="true"><svg viewBox="0 0 720 560" focusable="false"><use href="#fav-villa"/></svg></div>
    </section>
    <Divider ornament tone="brass" style={{ maxWidth: 320, margin: '0 auto' }} />

    <section class="sec center" style="--max:780px; --pt:80px; --pb:20px">
      <Eyebrow rules tone="brass">{c.t.introEyebrow}</Eyebrow>
      <p class="intro">
        {c.t.introText}
      </p>
    </section>

    <section class="sec" style="--max:1200px; --pt:56px; --pb:88px">
      <div class="grid grid-3">
        {atmospheres.map((a) => (
          <a href={`/journal/${a.slug}`} class="atmos">
            {a.img && <MediaImage media={a.img} alt="" class="media media--4x3 atmos__img" sizes="(max-width: 620px) 100vw, (max-width: 960px) 50vw, 380px" />}
            <h2>{a.title}</h2>
            <p>{a.copy}</p>
            <span class="read-more">{c.t.cardReadMore}</span>
          </a>
        ))}
      </div>
    </section>

    <section class="band band--tint" style="--max:900px; --pt:80px; --pb:80px">
      <div class="inner">
        <Eyebrow rules tone="brass">{c.t.departuresEyebrow}</Eyebrow>
        <h2 class="display-md center departures__title">{c.t.departuresTitle}</h2>
        <Departures />
        <div class="center" style="margin-top:28px"><Button href="/availability">{c.t.departuresButton}</Button></div>
      </div>
    </section>

    <section class="sec" style="--max:1080px; --pt:88px; --pb:88px">
      <Eyebrow rules tone="brass">{c.t.tiersEyebrow}</Eyebrow>
      <h2 class="display-lg center tiers__title">{c.t.tiersTitle}</h2>
      <div class="grid split">
        {tiers.map((t) => (
          <div class="frame">
            <div class="frame__inner tier">
              <div class="label">{t.eyebrow}</div>
              <h3>{t.name}</h3>
              <p>{t.copy}</p>
              <div class="label label--12">{c.t.tierPrice}</div>
              <div style="margin-top:18px"><Button variant="ghost" href="/journey">{t.cta}</Button></div>
            </div>
          </div>
        ))}
      </div>
    </section>

    <section class="band band--inverse" style="--max:1000px; --pt:76px; --pb:76px">
      <div class="inner grid grid-4 center" style="--gap:32px">
        {trust.map(([t, copy]) => (
          <div>
            <div class="trust__title">{t}</div>
            <div class="trust__rule" aria-hidden="true"></div>
            <p class="trust__copy">{copy}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="band band--tint" style="--max:760px; --pt:84px; --pb:84px">
      <div class="inner voices">
        <Eyebrow rules tone="brass">{c.t.voicesEyebrow}</Eyebrow>
        <Testimonials client:idle voices={voices} />
      </div>
    </section>

    <section class="sec center" style="--pt:84px; --pb:84px">
      <Eyebrow tone="brass">{c.t.closingEyebrow}</Eyebrow>
      <h2 class="display-lg closing__title">{c.t.closingTitle}</h2>
      <Button size="lg" href="/enquire">{c.t.closingButton}</Button>
    </section>
  </main>
</BaseLayout>

<style>
  .hero { position: relative; overflow: hidden; text-align: center; padding: 92px 40px 84px; }
  .hero__content { position: relative; z-index: 1; }
  .hero__crest { height: 104px; width: auto; }
  .hero h1 { margin: 26px auto 0; max-width: 800px; }
  .hero__lead { font-size: 17px; margin: 20px auto 0; max-width: 620px; }
  .hero__ctas { display: flex; gap: 16px; justify-content: center; flex-wrap: wrap; margin-top: 34px; }

  .intro { font-family: var(--font-display); font-size: 24px; line-height: 1.5; color: var(--text-heading); margin: 22px 0 0; }

  .atmos { display: block; color: inherit; }
  .atmos:hover { color: inherit; }
  .atmos__img { border: 1px solid var(--border-hairline); }
  .atmos h2 { font-size: 22px; margin: 18px 0 8px; }
  .atmos p { font-size: 14px; margin: 0 0 12px; }
  .atmos:hover .read-more { color: var(--accent-text); }

  .departures__title { margin: 14px 0 36px; }

  .tiers__title { margin: 14px 0 44px; }
  .tier { padding: 32px 34px; }
  .tier h3 { font-size: 28px; margin: 10px 0 12px; }
  .tier p { font-size: 14px; margin: 0 0 18px; }

  .trust__title { font-family: var(--font-display); font-size: 24px; color: var(--text-on-dark); }
  .trust__rule { width: 24px; height: 1px; background: var(--color-brass-light); margin: 12px auto; }
  .trust__copy { font-family: var(--font-sans); font-size: 13px; color: var(--text-on-dark); opacity: 0.7; margin: 0; }

  .voices { display: flex; flex-direction: column; align-items: center; }

  .closing__title { margin: 12px auto 20px; max-width: 620px; }

  @media (max-width: 620px) {
    .hero { padding: 60px 22px 56px; }
    .tier { padding: 28px 24px; }
  }
</style>
